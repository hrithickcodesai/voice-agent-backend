{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprod-voice-agent",
  "account_id": "096aa2e876fca5b89eaea5d2de970ea8",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  // non-secret agent config, forwarded into the container as env vars
  "vars": {
    "LLM_MODEL": "qwen/qwen3.5-122b-a10b",
    "AGENT_NAME": "Alex"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "VoiceAgentContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 25
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_AGENT_CONTAINER",
        "class_name": "VoiceAgentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgentContainer"]
    }
  ]
}
