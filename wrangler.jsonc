{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprod-voice-agent",
  "account_id": "096aa2e876fca5b89eaea5d2de970ea8",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  // non-secret agent config, forwarded into the container as env vars
  "vars": {
    "LLM_MODEL": "qwen/qwen3.5-122b-a10b",
    "AGENT_NAME": "Alex",
    // Google OAuth web client id (public). Empty = sign-in disabled, calls
    // stay anonymous and there is no call log.
    "GOOGLE_CLIENT_ID": ""
  },
  // users, calls and call transcripts (Recents)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preprod-voice-agent-db",
      "database_id": "dcf8e9e0-58ea-4922-8a99-bfd85c35b61f",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "VoiceAgentContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 25
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_AGENT_CONTAINER",
        "class_name": "VoiceAgentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgentContainer"]
    }
  ]
}
